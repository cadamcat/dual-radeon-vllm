# Build products — never commit the library, it goes to Releases with a checksum
*.so
*.so.*
!*.so.example
build/rccl-*/
build/_build/
*.o
*.tar.gz

# Compiled probes
diagnose/hipgate
diagnose/hipgate2
diagnose/hipgate3
diagnose/*.out

# Full logs (only the trimmed excerpt is tracked)
diagnose/logs/*-full.txt
*.log
!diagnose/logs/amdlog-crash-excerpt.txt
# ...but benchmark session logs ARE the raw layer verify_doc_figures.py
# recomputes from, so they have to travel with the repo.
!benchmarks/**/logs*/**/*.log
# The W4A16 A/B keeps its evidence beside the campaign rather than in a logs/
# directory, so the rule above misses it and c28e4c1 shipped a gate that could
# not run from a clean checkout: `verify_doc_figures.py` died with
# FileNotFoundError on c1-ab.log. Found 2026-09-04 by running the gate in a
# pristine worktree, which is the test this class of defect needs.
!benchmarks/gfx1100-w4a16-54706/c1-ab.log
!benchmarks/gfx1100-w4a16-54706/build-*/build.log

# OS / editor
.DS_Store
*.swp
.vscode/
.idea/

# cached public-domain source for the prompt cutter
benchmarks/prompts/.gutenberg-1228.txt
benchmarks/prompts/gemma/
benchmarks/prompts/qwen/
benchmarks/prompts/gemma26b/

# Python bytecode from running the analyze scripts in-tree
__pycache__/
*.pyc
