@@ -24,9 +24,12 @@ bool Kernel::init() {
         !device().info().pcie_atomics_) {
       setHostcallUnsatisfiable(true);
       LogPrintfError("kernel %s declares hidden_hostcall_buffer (device printf/assert) but device %s "
